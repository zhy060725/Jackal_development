<launch>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="linear_speed" default="0.1"/>
  <arg name="angular_speed" default="0.2"/>
  <arg name="initial_speed" default="0.3"/>
  <arg name="speed_step" default="0.1"/>
  <arg name="publish_rate" default="20.0"/>

  <node pkg="my_robot_package" type="keyboard_control.py" name="keyboard_control" output="screen">
    <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
    <param name="linear_speed" value="$(arg linear_speed)"/>
    <param name="angular_speed" value="$(arg angular_speed)"/>
    <param name="initial_speed" value="$(arg initial_speed)"/>
    <param name="speed_step" value="$(arg speed_step)"/>
    <param name="publish_rate" value="$(arg publish_rate)"/>
  </node>
</launch>
